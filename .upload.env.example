# Copy to .upload.env (gitignored) and fill in, then `make push CH=...` works.
#
#   cp .upload.env.example .upload.env

# Name you gave the Google Drive remote during `rclone config`.
RCLONE_REMOTE=gdrive

# Folder inside that Drive to upload into. Must already exist.
# Leave empty to upload to the root of the Drive.
DRIVE_FOLDER=Thesis
